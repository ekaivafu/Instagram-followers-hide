# Get this from @BotFather
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_TOKEN

# Comma-separated Telegram user IDs that can use /admin
# Get your numeric ID from @userinfobot
ADMIN_IDS=123456789

# Shown as "Need help? Contact @..." in the bot
SUPPORT_USERNAME=@tgekaiva

# Local dev default. On Render this is set automatically from the database.
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Render sets RENDER_EXTERNAL_URL automatically, so webhook mode is automatic there.
# Set WEBHOOK_URL only for other hosts (must end with /webhook).
# WEBHOOK_URL=https://your-app.onrender.com/webhook
# WEBHOOK_SECRET=some-long-random-string
